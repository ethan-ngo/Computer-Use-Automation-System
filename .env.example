# Copy to .env and fill in. Credentials are referenced by name from capability
# artifacts (never stored in them). .env is gitignored; this file must stay
# placeholder-only.
ANTHROPIC_API_KEY=sk-ant-...
# Only needed when the key is organization-scoped rather than workspace-scoped.
ANTHROPIC_WORKSPACE_ID=
PARABANK_USERNAME=john
PARABANK_PASSWORD=demo
